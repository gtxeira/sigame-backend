# --- Configurações do Servidor Web e Portas  ---
CORS_ALLOW_ORIGINS='^http://localhost:3000$'

# --- Segredos da Aplicação (Usados no compose.yaml e compose.prod.yaml) ---
APP_ENV=test
APP_DEBUG=1
KERNEL_CLASS=App\Kernel

# --- Tokens de Autenticação ---
JWT_PASSPHRASE=change-me-with-at-least-32-characters
ACCESS_TOKEN_SECRET=change-me-with-at-least-32-characters
ACCESS_TOKEN_ISSUER=sigame
ACCESS_TOKEN_AUDIENCE=sigame-api
ACCESS_TOKEN_TTL=900

REFRESH_TOKEN_TTL=604800
REFRESH_TOKEN_REUSE_GRACE_SECONDS=0
REFRESH_TOKEN_MAX_FAMILIES=5
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=strict

JWKS_CACHE_TTL=3600
OAUTH_FLOW_TTL=600
SOCIAL_LINK_TICKET_TTL=600
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=1800
PASSWORD_RESET_COOLDOWN=60

AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=5
AUTH_SOCIAL_START_RATE_LIMIT=20
AUTH_SOCIAL_CALLBACK_RATE_LIMIT=10
AUTH_SOCIAL_LINK_RATE_LIMIT=10
AUTH_EMAIL_VERIFY_RATE_LIMIT=10
AUTH_EMAIL_RESEND_RATE_LIMIT=3
AUTH_PASSWORD_FORGOT_RATE_LIMIT=5
AUTH_PASSWORD_RESET_RATE_LIMIT=10
AUTH_PASSWORD_CHANGE_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
USER_CPF_RATE_LIMIT=10

# --- Login social (Google) ---
GOOGLE_CLIENT_ID=test-client
GOOGLE_CLIENT_SECRET=test-secret
GOOGLE_REDIRECT_URI_WEB=http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI_DEV="${DEFAULT_URI}/dev/google-oauth"

# --- Credenciais Armazenamento S3 ---
S3_ENDPOINT_TEST="${S3_ENDPOINT}"
S3_REGION_TEST="${S3_REGION}"
S3_ACCESS_KEY_TEST="${S3_ACCESS_KEY}"
S3_SECRET_KEY_TEST="${S3_SECRET_KEY}"
S3_BUCKET_TEST="profile-images-test"
S3_PUBLIC_URL_TEST="http://${S3_BUCKET_TEST}.localhost:3902"

# --- Symfony Lock ---
LOCK_DSN=flock

# --- Symfony Mailer ---
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@sigame.test
MAILER_FROM_NAME=SIGAME
FRONTEND_URL=http://localhost:3000

# --- Symfony Messenger ---
# Os testes executam os handlers em processo, sem worker.
MESSENGER_TRANSPORT_DSN=sync://
MESSENGER_MAIL_ENCRYPTION_KEY=ChangeMe
