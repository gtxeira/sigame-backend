# --- Segredos da Aplicação (Usados no compose.yaml e compose.prod.yaml) ---
APP_ENV=test
APP_DEBUG=1
KERNEL_CLASS=App\Kernel

# --- Credenciais Armazenamento S3 ---
S3_ENDPOINT_TEST="${S3_ENDPOINT}"
S3_REGION_TEST="${S3_REGION}"
S3_ACCESS_KEY_TEST="${S3_ACCESS_KEY}"
S3_SECRET_KEY_TEST="${S3_SECRET_KEY}"
S3_BUCKET_TEST="profile-images-test"
S3_PUBLIC_URL_TEST="http://${S3_BUCKET_TEST}.localhost:3902"
