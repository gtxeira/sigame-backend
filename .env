# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

# --- Configurações do Servidor Web e Portas (Usadas no compose.yaml) ---
SERVER_NAME=api.sigame.localhost
HTTP_PORT=8000
HTTPS_PORT=8443
HTTP3_PORT=8443
# Regex de origens exatas com credenciais. Em produção, sobrescrever com o domínio real.
CORS_ALLOW_ORIGINS=^https://sigame\.com\.br$

# --- Segredos da Aplicação (Usados no compose.yaml e compose.prod.yaml) ---
APP_ENV=dev
APP_SECRET=ChangeMeInLocalOrProd
CADDY_MERCURE_JWT_SECRET=ChangeMeInLocalOrProd
DEFAULT_URI="https://${SERVER_NAME}:${HTTPS_PORT}" # --- symfony/routing ---

# --- Credenciais do Banco de Dados (PostgreSQL) ---
POSTGRES_USER=sigame
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_DB=sigame
POSTGRES_VERSION=18
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"

# --- Tokens de Autenticação ---
JWT_PASSPHRASE=change-me-with-at-least-32-characters
ACCESS_TOKEN_SECRET=change-me-with-at-least-32-characters
ACCESS_TOKEN_ISSUER=sigame
ACCESS_TOKEN_AUDIENCE=sigame-api
ACCESS_TOKEN_TTL=900

REFRESH_TOKEN_TTL=604800
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
REFRESH_TOKEN_MAX_FAMILIES=5
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=1
REFRESH_COOKIE_SAMESITE=lax

JWKS_CACHE_TTL=3600
OAUTH_FLOW_TTL=600
SOCIAL_LINK_TICKET_TTL=600
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=1800
PASSWORD_RESET_COOLDOWN=60

AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=5
AUTH_SOCIAL_START_RATE_LIMIT=20
AUTH_SOCIAL_CALLBACK_RATE_LIMIT=10
AUTH_SOCIAL_LINK_RATE_LIMIT=10
AUTH_EMAIL_VERIFY_RATE_LIMIT=10
AUTH_EMAIL_RESEND_RATE_LIMIT=3
AUTH_PASSWORD_FORGOT_RATE_LIMIT=5
AUTH_PASSWORD_RESET_RATE_LIMIT=10
AUTH_PASSWORD_CHANGE_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=30
USER_CPF_RATE_LIMIT=10
USER_ONBOARDING_RATE_LIMIT=10
USER_PHOTO_RATE_LIMIT=10
USER_PROFILE_RATE_LIMIT=10
GROUP_CREATE_RATE_LIMIT=5
GROUP_MEMBERSHIP_REQUEST_RATE_LIMIT=10
GROUP_MANAGE_RATE_LIMIT=30
ACTIVITY_CREATE_RATE_LIMIT=10
ACTIVITY_MANAGE_RATE_LIMIT=30
ACTIVITY_ENROLL_RATE_LIMIT=20
GAMIFICATION_READ_RATE_LIMIT=60
NOTIFICATIONS_READ_RATE_LIMIT=60
NOTIFICATIONS_WRITE_RATE_LIMIT=30
NOTIFICATIONS_REALTIME_RATE_LIMIT=10
ADMIN_USERS_READ_RATE_LIMIT=60
ADMIN_USERS_MANAGE_RATE_LIMIT=10

# --- Login social (Google) ---
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI_WEB=https://example.com/login/google/callback
GOOGLE_REDIRECT_URI_DEV="${DEFAULT_URI}/dev/google-oauth"

# --- Credenciais Armazenamento S3 ---
S3_ENDPOINT="http://garage:3900"
S3_REGION="garage"
S3_PATH_STYLE=true
S3_ACCESS_KEY=GK_ChangeMeInLocalOrProd
S3_SECRET_KEY=ChangeMeInLocalOrProd
S3_BUCKET="profile-images"
S3_PUBLIC_URL="http://${S3_BUCKET}.localhost:3902"

# --- Symfony Lock ---
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock

# --- Symfony Mailer ---
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@sigame.com.br
MAILER_FROM_NAME=SIGAME
FRONTEND_URL=http://localhost:3000

# --- Symfony Messenger ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Chave de encriptação dos payloads de e-mail (base64 de 32 bytes).
MESSENGER_MAIL_ENCRYPTION_KEY=ChangeMeInLocalOrProd

###> symfony/mercure-bundle ###
# URL interna usada pela aplicação para publicar atualizações.
MERCURE_URL=http://php/.well-known/mercure
# URL pública usada pelo navegador/app para assinar o stream SSE.
MERCURE_PUBLIC_URL=https://api.sigame.localhost:8443/.well-known/mercure
# Segredo compartilhado com o hub (mesmo valor de CADDY_MERCURE_JWT_SECRET).
MERCURE_JWT_SECRET=${CADDY_MERCURE_JWT_SECRET}
# Emissor dos JWTs do Mercure.
MERCURE_JWT_ISSUER=sigame
# Namespace lógico dos tópicos privados por usuário.
MERCURE_TOPIC_BASE=https://sigame.app/notifications
# Tempo de vida do token de assinatura do sino, em segundos.
MERCURE_SUBSCRIBER_TOKEN_TTL=900
# Origens liberadas no hub SSE (separadas por espaço).
MERCURE_EXTRA_DIRECTIVES="cors_origins http://localhost:3000"
###< symfony/mercure-bundle ###
