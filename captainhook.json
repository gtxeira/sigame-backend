{
  "config": {
    "bootstrap": "vendor/autoload.php"
  },
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit",
        "options": {
          "config": {
            "typeCase": "lower",
            "types": ["feat", "fix", "ci", "docs", "perf", "refactor", "style", "test", "chore", "revert"],
            "scopeCase": "lower",
            "scopeRequired": false,
            "descriptionCase": null,
            "descriptionEndMark": ""
          }
        }
      }
    ]
  },
  "prepare-commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\Ramsey\\CaptainHook\\PrepareConventionalCommit",
        "options": {
          "mode": "interactive"
        }
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
        {
            "action": "docker compose exec -T php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --path-mode=intersection {$STAGED_FILES|of-type:php}"
        },
        {
            "action": "git add {$STAGED_FILES|of-type:php}"
        },
        {
            "action": "docker compose exec -T php vendor/bin/phpstan analyse --no-progress {$STAGED_FILES|of-type:php}"
        }
    ]
  }
}
