{
  "config": {
    "bootstrap": "vendor/autoload.php"
  },
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit",
        "options": {
          "config": {
            "typeCase": "lower",
            "types": ["ci", "docs", "perf", "refactor", "style", "test", "chore", "revert"],
            "scopeCase": "lower",
            "scopeRequired": false,
            "descriptionCase": "lower",
            "descriptionEndMark": ""
          }
        }
      }
    ]
  },
  "prepare-commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\Ramsey\\CaptainHook\\PrepareConventionalCommit"
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
        {
            "action": "docker compose exec -T php vendor/bin/php-cs-fixer fix --diff --dry-run"
        },
        {
            "action": "docker compose exec -T php vendor/bin/phpstan analyse --no-progress"
        }
    ]
  }
}
