@startuml
' GERADO por `just docs-usecases` a partir de casos-de-uso.yaml. Não edite.
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Inter"
skinparam ArrowColor #6B7280
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #111827
}
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
  FontColor #111827
}
skinparam rectangle {
  BackgroundColor #F9FAFB
  BorderColor #D1D5DB
}
title Moderação (adiada) — SIGAME

actor "Usuário" as Ator_usuario

rectangle "SIGAME" {
  usecase "Denunciar usuário\n«adiado»" as UC_16_1 #FEE2E2
  usecase "Bloquear usuário\n«adiado»" as UC_17_1 #FEE2E2
}

Ator_usuario -- UC_16_1
Ator_usuario -- UC_17_1


legend right
  Casos sem marca estão implementados.
  «roadmap»: planejado, sem endpoint na V1.
  «adiado»: fora do escopo da V1.
endlegend
@enduml
