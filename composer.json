{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "docker": true
        },
        "ramsey/conventional-commits": {
            "config": {
                "typeCase": "lower",
                "types": [
                    "ci",
                    "docs",
                    "perf",
                    "refactor",
                    "style",
                    "test",
                    "chore",
                    "revert"
                ],
                "scopeCase": "lower",
                "scopeRequired": false,
                "descriptionCase": "lower",
                "descriptionEndMark": ""
            }
        }
    },
    "require": {
        "php": ">=8.5",
        "symfony/flex": "^2.11",
        "symfony/console": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/dotenv": "^8.1",
        "nelmio/api-doc-bundle": "^5.12",
        "symfony/twig-bundle": "^8.1",
        "symfony/asset": "^8.1",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/uid": "^8.1",
        "lcobucci/jwt": "^5.6",
        "league/flysystem": "^3.36",
        "league/flysystem-aws-s3-v3": "^3.35",
        "symfony/http-client": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.68",
        "captainhook/captainhook": "^5.29",
        "ramsey/conventional-commits": "^1.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin": "^5.0",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
