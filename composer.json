{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "docker": true
        },
        "ramsey/conventional-commits": {
            "config": {
                "typeCase": "lower",
                "types": ["ci", "docs", "perf", "refactor", "style", "test", "chore", "revert"],
                "scopeCase": "lower",
                "scopeRequired": false,
                "descriptionCase": "lower",
                "descriptionEndMark": ""
            }
        }
    },
    "require": {
        "php": ">=8.5",
        "symfony/flex": "^2.11",
        "symfony/console": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/dotenv": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.68",
        "captainhook/captainhook": "^5.29",
        "ramsey/conventional-commits": "^1.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-symfony": "^2.0",
        "pestphp/pest": "*",
        "pestphp/pest-plugin": "*",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    }
}
