{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "docker": true
        }
    },
    "require": {
        "symfony/flex": "^2.11",
        "symfony/console": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.68"
    }
}
