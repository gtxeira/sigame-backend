# --- Configurações do Servidor Web e Portas (Usadas no compose.yaml) ---
SERVER_NAME=api.sigame.localhost
CORS_ALLOW_ORIGINS='^https?://(app\.sigame\.localhost|localhost:3000|localhost:8443|api.sigame.localhost:8443|api.sigame.localhost)$'

# --- Segredos da Aplicação (Usados no compose.yaml e compose.prod.yaml) ---
APP_ENV=dev
APP_DEBUG=1

# --- Credenciais do Banco de Dados (PostgreSQL) ---
POSTGRES_USER=sigame
POSTGRES_DB=sigame

# --- Tokens de Autenticação ---
JWT_PASSPHRASE=change-me-with-at-least-32-characters
ACCESS_TOKEN_SECRET=dev-only-change-me-with-at-least-32-characters
# Necessário pois o front está em http://localhost:3000 e API em https://api.sigame.localhost
REFRESH_COOKIE_SAMESITE=none

# --- Proxy confiável (BFF do Nuxt) ---
# O front-end chama a API somente pelo servidor Nuxt, que repassa o IP real do
# navegador em X-Forwarded-For. Confiar apenas nas faixas privadas evita aceitar
# o cabeçalho de um cliente externo. As duas variáveis precisam existir juntas.
SYMFONY_TRUSTED_PROXIES=private_ranges
SYMFONY_TRUSTED_HEADERS=x-forwarded-for

# --- Login social (Google) ---
GOOGLE_REDIRECT_URI_WEB=http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI_DEV=https://localhost:8443/dev/google-oauth

# --- Credenciais Armazenamento S3 ---
GARAGE_RPC_SECRET=!ChangeMeInLocalOrProd!
GARAGE_ADMIN_TOKEN=!ChangeMeInLocalOrProd!
GARAGE_METRICS_TOKEN=!ChangeMeInLocalOrProd!

# --- Symfony Mailer ---
MAILER_DSN=smtp://mailer:1025
FRONTEND_URL=http://localhost:3000
